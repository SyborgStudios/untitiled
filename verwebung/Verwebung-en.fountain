ILDREN [[blue]]","uuid":"811D4710-21F3-4CFF-BB1C-B34B2EA9C6B6"},{"string":".EXT. BLANK WALL — DAY — THE CHILDREN [[blue]]","uuid":"332D169C-6460-437E-82DF-45B193EFCFDB"},{"string":".EXT.\/INT. OLD DISTILLERY — DAY — THE CHILDREN [[blue]]","uuid":"41127CF7-099D-4A03-962E-E5081E3BE1ED"},{"string":".EXT. WASTELAND — DAY — THE CHILDREN [[blue]]","uuid":"CD961743-D32A-48C7-B78C-43B5E5B89733"},{"string":".EXT. ALCOVE BETWEEN TWO HOUSES — NIGHT — THE CHILDREN [[blue]]","uuid":"DA886EFE-1FE1-4B53-8D8E-507BAB995755"},{"string":".EXT. ALCOVE BETWEEN TWO HOUSES — MORNING — THE CHILDREN [[blue]]","uuid":"9EEF6862-8D44-47B4-B8A6-0F3A239EF8FC"},{"string":"# 8. THE PARENTS · Seq II \"Two Buyers\" (F7b–F8a)","uuid":"78A784B2-00B5-4C30-AA58-2BEF3B77F3BC"},{"string":".EXT. MARKET SQUARE — DAY — THE PARENTS [[orange]]","uuid":"506CE80C-C04F-4AF1-9A7B-9131072CC490"},{"string":".INT. KITCHEN, KESSLER HOUSE — NIGHT — THE PARENTS [[orange]]","uuid":"068387E6-20D9-44E3-87F8-1F4DF3A417D7"},{"string":".EXT. CHURCH — DAY — THE PARENTS [[orange]]","uuid":"F8EC43FA-53EC-4F3B-80DE-EE3AE3A0329A"},{"string":"# 9. THE CHILDREN · Seq 3 \"The City\" (G23–G29)","uuid":"E21B0630-8273-406A-B7F8-85A8F1482417"},{"string":".EXT. CHURCH — DAY — THE CHILDREN [[blue]]","uuid":"BBF2ECEA-3212-4A83-ADF1-CBB00CEC156D"},{"string":".INT. CHURCH — DAY — THE CHILDREN [[blue]]","uuid":"7407037B-763B-490B-83A6-FDBAB42E958C"},{"string":".EXT.\/INT. ATTIC ABOVE A DEAD ALLEY — EVENING — THE CHILDREN [[blue]]","uuid":"D2F27440-10F9-4704-B580-37D1AD218060"},{"string":".EXT. WASHHOUSE — DAY — THE CHILDREN [[blue]]","uuid":"6CE0BCD0-94A6-4993-96BC-94D50F7437D2"},{"string":".INT. WASHHOUSE — DAY — THE CHILDREN [[blue]]","uuid":"2AB68050-E549-4336-AA35-297B6CBAABBD"},{"string":".EXT.\/INT. WASHHOUSE — EVENING — THE CHILDREN [[blue]]","uuid":"9AB9E078-DA08-4135-AFFB-082FC8946E26"},{"string":".EXT.\/INT. ATTIC ABOVE A DEAD ALLEY — NIGHT — THE CHILDREN [[blue]]","uuid":"D84DBC97-A7EF-4849-B89D-74C1BE8E82F4"},{"string":"# 10. THE P